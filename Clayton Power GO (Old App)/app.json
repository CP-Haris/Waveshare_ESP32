{
  "expo": {
    "name": "ClaytonPower",
    "slug": "ClaytonPower",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/imanpm ges/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#202020"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.claytonpower.ClaytonPower"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#202020"
      },
      "package": "com.claytonpower.ClaytonPower"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "entryPoint": "./index.tsx"
  }
}
